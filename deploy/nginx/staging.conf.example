# =============================================================================
# Nginx Ingress Reverse Proxy Configuration (Staging Validation Example)
# Conforms to DOC-REP-6.2.5-PLAN Section 5 & Section 17.
# NOTE: PROPOSED STAGING VALIDATION TOPOLOGY — NOT OWNER APPROVED HOSTING PLATFORM
# =============================================================================

# Rate limiting zone: 20 requests/second burst 10 per IP (Edge Defense)
limit_req_zone $binary_remote_addr zone=staging_edge_limit:10m rate=20r/s;

# Cleartext HTTP -> HTTPS Permanent Redirection
server {
    listen 80;
    listen [::]:80;
    server_name staging.studio.internal;

    return 301 https://$host$request_uri;
}

# HTTPS Ingress
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name staging.studio.internal;

    # TLS Configuration
    ssl_certificate /etc/letsencrypt/live/staging.studio.internal/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/staging.studio.internal/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Perimeter Payload Defense: 1MB client body limit
    client_max_body_size 1m;

    # Security Headers
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    # Static Assets Direct Serving
    location /static/ {
        alias /var/www/studio-website/static/;
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # Dynamic Application Reverse Proxy to FastAPI
    location / {
        limit_req zone=staging_edge_limit burst=10 nodelay;

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        # Timeout bounding (exceeds AI Gateway 10s timeout)
        proxy_connect_timeout 15s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
    }
}
