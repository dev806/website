# =============================================================================
# Caddy Ingress Reverse Proxy Configuration (Staging Validation Example)
# Conforms to DOC-REP-6.2.5-PLAN Section 5 & Section 17.
# NOTE: PROPOSED STAGING VALIDATION TOPOLOGY — NOT OWNER APPROVED HOSTING PLATFORM
# =============================================================================

staging.studio.internal {
    # 1. Automated Modern TLS Termination
    tls {
        protocols tls1.2 tls1.3
    }

    # 2. Perimeter Payload Defense: Enforce 1MB client body limit
    request_body {
        max_size 1MB
    }

    # 3. Environment-Specific SEO Safeguard: Staging disallow
    @robots path /robots.txt
    handle @robots {
        header Content-Type text/plain
        respond "User-agent: *\nDisallow: /\n"
    }

    # 4. Security & Isolation Headers
    header {
        X-Robots-Tag "noindex, nofollow, noarchive"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        -Server
    }

    # 5. Direct Static Asset Serving with Immutable Caching
    @static path /static/*
    handle @static {
        root * /var/www/studio-website
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # 6. Reverse Proxy to FastAPI / Uvicorn Multi-Worker Runtime
    handle {
        reverse_proxy 127.0.0.1:8000 {
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {host}
            
            # Health check timeout bounding
            transport http {
                response_header_timeout 15s
            }
        }
    }

    # 7. Structured JSON Access Logging
    log {
        output file /var/log/caddy/staging_access.log {
            roll_size 10mb
            roll_keep 5
        }
        format json
    }
}
