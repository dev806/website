# -----------------------------------------------------------------------------
# [STUDIO_NAME] — Environment Configuration Template
# Copy this file to .env and adjust values for local development.
# Real secrets must never be committed to source control.
# -----------------------------------------------------------------------------

# Core Application Settings
APP_NAME=[STUDIO_NAME]
APP_ENV=development
DEBUG=True
SECRET_KEY=change-this-in-production-use-a-secure-random-string-with-at-least-32-chars
BASE_URL=http://localhost:8000

# Database Persistence (Microsoft SQL Server 2022 Express)
# Using validated mssql+pyodbc connection strategy
DATABASE_URL=mssql+pyodbc:///?odbc_connect=Driver%3D%7BODBC+Driver+18+for+SQL+Server%7D%3BServer%3D.%5CSQLEXPRESS%3BDatabase%3DStudioWebsiteDev%3BTrusted_Connection%3Dyes%3BTrustServerCertificate%3Dyes%3B
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=1800

# AI Gateway Subsystem
AI_GATEWAY_MODE=mock
AI_TIMEOUT_SECONDS=10.0
AI_PRIMARY_MODEL=studio-mock-v1

# Session & Security Settings
SESSION_COOKIE_NAME=studio_session_id
SESSION_MAX_AGE_SECONDS=2592000
SESSION_SECURE_COOKIE=False

# Notifications & SMTP (Disabled for MVP Foundation)
SMTP_ENABLED=False
ARCHITECT_ALERT_EMAIL=architects@studio.internal
